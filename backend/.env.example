ENV=development

# Supabase: Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[TU-PASSWORD]@db.xxxxxxxxxx.supabase.co:5432/postgres

# Clave secreta para JWT — todos deben usar la misma
